# Copie para .env e preencha. O .env nunca vai para o Git.

DATABASE_URL=postgres://postgres:senha_local@localhost:5433/agencia
PORT=3000

# reCAPTCHA v3 — sem ele, o formulário só funciona em desenvolvimento
RECAPTCHA_SECRET=

# Painel /admin
ADMIN_USER=
ADMIN_PASS=

# WhatsApp Cloud API (developers.facebook.com → seu app → WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WA_VERIFY_TOKEN=          # frase que você inventa e repete no cadastro do webhook
WA_APP_SECRET=            # Configurações do app → Básico → Chave Secreta do App
WA_API_VERSION=v23.0      # confira a versão atual no painel da Meta

# Agente de IA — sem a chave, dúvidas livres vão direto para um consultor
ANTHROPIC_API_KEY=

# Demonstração: 1 = mensagens não saem para o WhatsApp e a tela /demo fica ativa.
# Nunca ligue em produção.
MODO_DEMO=
