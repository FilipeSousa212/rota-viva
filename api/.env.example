# Copie para .env e preencha. O .env nunca vai para o Git.

DATABASE_URL=postgres://postgres:senha_local@localhost:5433/agencia
PORT=3000

# Número de proxies na frente da API. No Render: 3 (Cloudflare + 2 balanceadores).
# Deixe vazio rodando no seu computador: sem proxy, confiar no cabeçalho deixa qualquer um forjar o IP.
TRUST_PROXY=

# reCAPTCHA v3. Sem a chave, o formulário é RECUSADO, a menos que RECAPTCHA_DESATIVADO=1 (só para testes).
RECAPTCHA_SECRET=
RECAPTCHA_DESATIVADO=

# Painel /admin — duas contas, ambas só de leitura: a da agência e a do cliente.
# Para cortar o acesso do cliente sem mexer na sua senha, apague CLIENTE_PASS.
ADMIN_USER=
ADMIN_PASS=
CLIENTE_USER=
CLIENTE_PASS=

# WhatsApp Cloud API (developers.facebook.com → seu app → WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v23.0

# Agente de IA. Sem a chave, dúvidas livres vão para um consultor (ou para respostas prontas, na demonstração).
ANTHROPIC_API_KEY=

# Demonstração: 1 = mensagens não saem para o WhatsApp e a tela /demo fica ativa, só com telefones fictícios.
# A API se recusa a iniciar com MODO_DEMO=1 e WHATSAPP_TOKEN preenchidos ao mesmo tempo.
MODO_DEMO=